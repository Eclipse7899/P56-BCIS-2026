{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && src/firebase emulators:start --only functions",
    "shell": "npm run build && src/firebase functions:shell",
    "start": "npm run shell",
    "proto:generate": "npx protoc --ts_out ./src --proto_path ../protobuf ../protobuf/*.proto ",
    "deploy": "src/firebase deploy --only functions",
    "logs": "src/firebase functions:log"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/src/index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0",
    "protobufjs": "^8.8.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "^2.11.1",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "ts-proto": "^2.13.0",
    "typescript": "^6.0.0"
  },
  "private": true
}
